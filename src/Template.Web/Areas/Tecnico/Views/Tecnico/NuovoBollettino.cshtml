@{
    ViewData["Title"] = "Nuovo Bollettino";
}
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script src="~/js/nuovobollettino-ckeditor.js"></script>
}
<div class="container mt-4">
    <div class="row mb-3 align-items-center">
            <div class="col-auto me-3">
                <a href="/Tecnico/Tecnico/BollettiniCaricati" class="btn btn-outline-secondary">&leftarrow; Torna ai bollettini</a>
            </div>
            <div class="col">
                <h1 class="mb-0">Nuovo Bollettino</h1>
            </div>
    </div>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="contenutoBollettino" class="form-label">Inserisci il contenuto</label>
                    <textarea class="form-control" id="contenutoBollettino" name="contenutoBollettino" placeholder="Inserisci il contenuto ..."></textarea>
                </div>
            </div>
            <div class="col-md-6">
                <form class="h-100 d-flex flex-column justify-content-between">
                    <div class="mb-3">
                        <label for="nomeBollettino" class="form-label">Nome Bollettino</label>
                        <input type="text" class="form-control" id="nomeBollettino" placeholder="Inserisci il nome del bollettino">
                    </div>
                    <div class="mb-3">
                        <label for="culturaInteresse" class="form-label">Cultura di interesse</label>
                        <select id="culturaInteresse" class="form-select text-secondary">
                            <option value="">Seleziona almeno una coltura di interesse</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="zonaInteresse" class="form-label">Zone di interesse</label>
                        <select id="zonaInteresse" class="form-select text-secondary">
                            <option value="">Seleziona almeno una zona di interesse</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="scadenzaTemporale" class="form-label">Scadenza temporale</label>
                        <input type="text" class="form-control" id="scadenzaTemporale" placeholder="gg/mm/anno">
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-4">
                        <button type="button" class="btn btn-outline-secondary">Annulla</button>
                        <button type="button" class="btn btn-light">Salva</button>
                        <button type="submit" class="btn btn-success" id="pubblicaBollettinoBtn">Pubblica</button>
                    </div>
                </form>
            </div>
        </div>
    </div> 
</div>