@model Template.Web.Areas.Tecnico.ViewModels.NuovoBollettinoViewModel
@{
    ViewData["Title"] = "Nuovo Bollettino";
    var coltureDict = Model.OpzioniColture.ToDictionary(x => x.Value, x => x.Text);
    var provinceDict = Model.OpzioniProvince.ToDictionary(x => x.Value, x => x.Text);
}

<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col-auto me-3">
            <a href="/Tecnico/Tecnico/BollettiniCaricati" class="btn btn-outline-secondary">&leftarrow; Torna ai bollettini</a>
        </div>
        <div class="col">
            <h1 class="mb-0">Nuovo Bollettino</h1>
        </div>
    </div>

    <div class="mt-4">
        @using (Html.BeginForm("NuovoBollettino", "Tecnico", FormMethod.Post, new { @class = "d-flex gap-5" }))
        {
            @* editor wysiwyg *@
            <div class="flex-grow-1">
                @* <label for="contenutoBollettino" class="form-label">Inserisci il contenuto</label> *@
                <textarea id="editor" name="@nameof(Model.ContenutoBollettino)">
                    @Model.ContenutoBollettino
                </textarea>
            </div>

            <div class="col-12 col-md-4">
                @* stato documento *@
                <div class="mb-3">
                    <sl-select name="@nameof(Model.Pubblicato)" label="Stato documento" value="@Model.Pubblicato.ToString()">
                            <sl-option value="False">
                            <sl-icon slot="prefix" name="clock"></sl-icon>
                            Bozza
                        </sl-option>
                            <sl-option value="True">
                            <sl-icon slot="prefix" name="check2-circle"></sl-icon>
                            Pubblicato
                        </sl-option>
                    </sl-select>
                </div>

                @* colture *@
                <div class="mb-3">
                    <sl-select name="@nameof(Model.IdColtureSelezionate)" label="Colture di interesse" value="@string.Join(',', Model.IdColtureSelezionate)" multiple clearable>
                        @foreach (var option in Model.OpzioniColture)
                        {
                            <sl-option value="@option.Value">@option.Text</sl-option>
                        }
                    </sl-select>
                </div>

                @* province *@
                <div class="mb-3">
                    <sl-select name="@nameof(Model.IdProvinceSelezionate)" label="Zone di interesse" value="@string.Join(',', Model.IdProvinceSelezionate)"  multiple clearable>
                        @foreach (var option in Model.OpzioniProvince)
                        {
                            <sl-option value="@option.Value">@option.Text</sl-option>
                        }
                    </sl-select>
                </div>

                @* scadenza *@
                <div class="mb-3">
                    <sl-input type="date" label="Scadenza" name="@nameof(Model.Scadenza)" value="@(Model.Scadenza.HasValue? Model.Scadenza.Value.ToString("yyyy-MM-dd") : "")" placeholder="Date"></sl-input>
                </div>

                @* titolo *@
                <div class="mb-3">
                    <sl-input label="Nome Bollettino" name="@nameof(Model.TitoloBollettino)" clearable></sl-input>
                </div>

                @* azioni *@
                <div class="d-flex justify-content-between gap-2 mt-4 mb-4">
                    <button type="button" class="btn btn-outline-secondary">Annulla</button>
                    <button type="submit" id="pubblicaBtn" class="btn btn-success @(Model.Pubblicato ? "d-block" : "d-none")">Pubblica</button>
                    <button type="submit" id="salvaBtn" class="btn btn-success @(!Model.Pubblicato ? "d-block" : "d-none")">Salva per dopo</button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
    <script src="~/js/nuovobollettino-ckeditor.js"></script>

    <script>
        const pubblicatoSelect = document.querySelector('sl-select[name=@nameof(Model.Pubblicato)]');
        const pubblicaBtn = document.getElementById('pubblicaBtn');
        const salvaBtn = document.getElementById('salvaBtn');
        pubblicatoSelect.addEventListener('sl-change', event => {
            const isBozza = event.target.value === "False";
            if (isBozza) {
                salvaBtn.classList.remove('d-none');
                pubblicaBtn.classList.add('d-none');
            } else {
                pubblicaBtn.classList.remove('d-none');
                salvaBtn.classList.add('d-none');
            }
        })

        const coltureMultiselect = document.querySelector('sl-select[name=@nameof(Model.IdColtureSelezionate)]');
        const provinceMultiselect = document.querySelector('sl-select[name=@nameof(Model.IdProvinceSelezionate)]');
        const summaryInput = document.querySelector('sl-input[name=@nameof(Model.TitoloBollettino)]');

        var allColtures = @Html.Raw(Json.Serialize(coltureDict));
        var allProvinces = @Html.Raw(Json.Serialize(provinceDict));

        coltureMultiselect.addEventListener('sl-change', event => {
            const values = event.target.value;
            const selectedColtureNames = values.map(v => allColtures[v])?.join(', ');
            const summaryOgValue = summaryInput.value;
            summaryInput.value = selectedColtureNames + " - " + (summaryOgValue.split(' - ')[1] || "");
        })

        provinceMultiselect.addEventListener('sl-change', event => {
            const values = event.target.value;
            const selectedProvinceNames = values.map(v => allProvinces[v])?.join(', ');
            const summaryOgValue = summaryInput.value;
            summaryInput.value = (summaryOgValue.split(' - ')[0] || "") + " - " + selectedProvinceNames;
        })
    </script>
}

