@{
    ViewData["Title"] = "Quasi fatto!";
    Layout = "~/Views/Shared/_LayoutAgricoltore.cshtml";
}

@Html.AntiForgeryToken()

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-5">
                <h1 class="display-4 text-success mb-3">🌱 Perfetto!</h1>
                <p class="lead text-muted">Ora dicci cosa coltivi e ti mostreremo i bollettini più rilevanti per te.</p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="d-flex justify-content-center mb-3">
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:40px;height:40px;font-weight:bold;">1</div>
                            <div class="bg-secondary" style="width:60px;height:3px;margin-top:18px;"></div>
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:40px;height:40px;font-weight:bold;">2</div>
                        </div>
                        <h3 class="text-success">Cosa coltivi?</h3>
                        <p class="text-muted">Seleziona le colture che ti interessano</p>
                    </div>

                    <div class="mb-4">
                        <div id="error" class="text-danger mb-2" style="display:none;"></div>
                        <sl-select id="select" label="Colture di interesse" multiple clearable>
                            <sl-option>Caricamento...</sl-option>
                        </sl-select>
                        <div class="form-text">Puoi selezionare più colture se coltivi diversi tipi di prodotti</div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                        <button type="button" id="prev" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="fas fa-arrow-left me-2"></i> Indietro
                        </button>
                        <button type="button" id="complete" class="btn btn-success btn-lg px-4">
                            Completato! <i class="fas fa-check ms-2"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-muted">Step 2 di 2</small>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    fetch('@Url.Action("GetColtures", "Agricoltore", new { area = "Agricoltore" })')
        .then(r => r.json())
        .then(r => {
            if (r.success) {
                const select = document.getElementById('select');
                select.innerHTML = '';
                r.data.forEach(c => {
                    const option = document.createElement('sl-option');
                    option.value = c.id;
                    option.textContent = c.name;
                    select.appendChild(option);
                });
            }
        });

    document.getElementById('prev').addEventListener('click', function() {
        window.location.href = '@Url.Action("OnboardingStep1", "Agricoltore", new { area = "Agricoltore" })';
    });

    document.getElementById('complete').addEventListener('click', function() {
        const select = document.getElementById('select');
        const selected = select.value || [];
        
        if (selected.length === 0) {
            const error = document.getElementById('error');
            error.textContent = 'Seleziona almeno una coltura di interesse';
            error.style.display = 'block';
            select.classList.add('error');
            return;
        }

        const provinces = JSON.parse(sessionStorage.getItem('onboarding_provinces') || '[]');
        if (provinces.length === 0) return;

        fetch('@Url.Action("SaveOnboardingPreferences", "Agricoltore", new { area = "Agricoltore" })', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ Provinces: provinces, Coltures: selected })
        })
        .then(r => r.json())
        .then(r => {
            if (r.success) {
                sessionStorage.removeItem('onboarding_provinces');
                window.location.href = r.redirectUrl;
            }
        });
    });
});
</script> 