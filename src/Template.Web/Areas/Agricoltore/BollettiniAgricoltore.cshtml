@model Template.Web.Areas.Agricoltore.ViewModels.BollettiniAgricoltoreViewModel

<div class="container mt-4">
    <h1 class="text-center mt-5">Bollettini Fitosanitari</h1>
    <div class="alert alert-light mb-4" role="alert">
        Stai visualizzando i bollettini in base alle tue colture e zone preferite.
        <a href="@Url.Action("ImpostazioniAgricoltore", "Agricoltore")" class="alert-link">Modifica le impostazioni</a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var bollettino in Model.Bollettini)
        {
            <div class="col">
                <partial name="~/Views/Shared/_BollettinoCard.cshtml" model="bollettino" />
            </div>
        }
    </div>

    <nav class="navbar navbar-expand justify-content-md-center mt-1">
        <ul class="navbar-nav flex-wrap"><partial name="~/Views/Shared/_PagingPartial.cshtml" model="Model" /></ul>
    </nav>
</div>

@section Styles {
    <style>
        .two-line-limit {
            max-height: calc(1em * 2 * 1.4); /* altezza stimata di due righe con line-height 1.4 */
            overflow: hidden;
        }
    </style>
}