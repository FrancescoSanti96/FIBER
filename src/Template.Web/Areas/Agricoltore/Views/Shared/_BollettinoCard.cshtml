@model Template.Web.Areas.Agricoltore.Models.BollettinoCardViewModel

<div class="bulletin-card border rounded p-3 mb-3 bg-white shadow-sm">
    <h2 class="h5">@Model.Title</h2>
    <p class="mb-2"><span class="badge rounded-pill bg-success">@Model.Tag1</span> <span class="badge rounded-pill bg-info">@Model.Tag2</span></p>
    <p class="text-secondary mb-3">@Model.Description</p>
    <div class="d-flex justify-content-between pt-3 border-top">
        <a href="@Model.ViewLink" class="btn btn-outline-secondary btn-sm">Visualizza</a>
        <a href="@Model.DownloadLink" class="btn btn-light btn-sm">Scarica pdf</a>
    </div>
</div> 