<!DOCTYPE html>
<html>
<head>
    <title>Impostazioni Agricoltore</title>
</head>
<body>
    <h1>Impostazioni</h1>
    <p>Modifica le preferenze per cambiare i bollettini consigliati</p>

    <div class="settings-section">
        <label for="zona-interesse">Zone di interesse</label>
        <select id="zona-interesse">
            <option value="">Seleziona almeno una zona di interesse</option>
        </select>
    </div>

    <div class="settings-section">
        <label for="cultura-interesse-settings">Coltura di interesse</label>
        <select id="cultura-interesse-settings">
            <option value="">Seleziona almeno una coltura di interesse</option>
        </select>
    </div>

    <button>Conferma</button>

</body>
</html> 