<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col-auto me-3">
            <a href="/Agricoltore/Agricoltore/BollettiniAgricoltore" class="btn btn-outline-secondary">&leftarrow; Torna ai bollettini</a>
        </div>
        <div class="col">
            <h1 class="mb-0">Bollettino Test1</h1>
            <p class="mt-1 mb-0"><div class="d-flex gap-2">
                        <span class="badge bg-success">Fragola</span>
                        <span class="badge bg-info">Modena</span>
                    </div></p>
