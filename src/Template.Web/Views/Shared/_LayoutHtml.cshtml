<!DOCTYPE html>
<html lang="@this.CurrentCulture().Name" class="@ViewData["FullscreenClass"]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Fiber</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <meta name="description" content="@ViewData["Description"]">
    @RenderSection("googlehead", false)
    @RenderSection("metas", false)
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif !important;
        }
    </style>
    <link href="~/node_modules/@@fortawesome/fontawesome-free/css/all.min.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/bundle-global.min.css" asp-append-version="true" rel="stylesheet" />
    @RenderSection("styles", false)
</head>
<body>
    @RenderSection("googlebody", false)
    @RenderBody()
    <script type="text/javascript">
        var clientLocale = '@this.CurrentCulture().Name';
    </script>
    <environment include="Development">
        <script src="~/js/bundle-global.js" asp-append-version="true"></script>
    </environment>
    <environment include="Staging,Production">
        <script src="~/js/bundle-global.min.js" asp-append-version="true"></script>
    </environment>
    @RenderSection("scripts", required: false)
</body>
</html>