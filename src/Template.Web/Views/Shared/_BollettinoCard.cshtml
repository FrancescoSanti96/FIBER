@model Template.Web.Models.BollettinoCardViewModel

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title mb-1 flex-grow-1 text-truncate">@Model.Titolo</h5>
            <div class="text-end">
                <small class="text-muted d-block">@Model.Scadenza</small>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var coltura in Model.Colture)
            {
                <span class="badge bg-success">@coltura</span>

            }
            @foreach (var provincia in Model.Province)
            {
                <span class="badge bg-info">@provincia</span>
            }
        </div>
        <div class="text-secondary my-3 two-line-limit">@Html.Raw(Model.Anteprima)</div>
        <div class="d-flex justify-content-between pt-3 border-top">
            <button class="btn btn-outline-secondary btn-sm">@(Model.Pubblicato == false ? "Anteprima" : "Visualizza")</button>
            @if (!Model.Pubblicato)
            {
                <a href="@Url.Action("ModificaBollettino", "Tecnico", new { Area = "Tecnico", id = Model.Id })" class="btn btn-light btn-sm">Modifica</a>
            }
            else
            {
                <a href="" class="btn btn-light btn-sm">Scarica pdf</a>
            }
        </div>
    </div>
</div>
