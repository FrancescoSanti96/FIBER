@using Template.Web.Areas
@model Template.Web.Models.BollettinoCardViewModel
@{
    var currentUserMail = (ViewData[IdentitaViewModel.VIEWDATA_IDENTITACORRENTE_KEY] as IdentitaViewModel).EmailUtenteCorrente;
    var currentUserIsAuthor = Model.EmailTecnico == currentUserMail;
    var currentArea = ViewContext.RouteData.Values["Area"]?.ToString();
    var controllerName = currentArea == "Tecnico" ? "Tecnico" : "Agricoltore";
    var visualizzaAction = currentArea == "Tecnico" ? "BollettinoTecnico" : "Bollettino";
    var modificaAction = currentArea == "Tecnico" ? "ModificaBollettino" : "ModificaBollettino";
    var downloadAction = currentArea == "Tecnico" ? "DownloadBollettino" : "DownloadBollettino";
}

<div class="card mb-3 border-2 @(currentUserIsAuthor ? "border-success" : "border-light") position-relative">
    <div class="card-body">
        @if (currentUserIsAuthor)
        {
            <span class="badge bg-success position-absolute top-0 end-0 m-2">Creato da te</span>
        }

        <h5 class="card-title mb-1 text-truncate">@Model.Titolo</h5>

        @if (Model.Scadenza != null)
        {
            <div class="mb-2">
                <small class="text-muted">
                    Scade il: @Model.Scadenza?.ToString("dd/MM/yyyy")
                </small>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 mb-2">
            @foreach (var coltura in Model.Colture)
            {
                <span class="badge bg-success">@coltura</span>
            }
            @foreach (var provincia in Model.Province)
            {
                <span class="badge bg-info">@provincia</span>
            }
        </div>

        <div class="text-secondary my-3">@Model.Anteprima</div>

        <div class="d-flex justify-content-between pt-3 border-top">
            <a href="@Url.Action(visualizzaAction, controllerName, new { Area = currentArea, id = Model.Id, isDraft = !Model.Pubblicato })" class="btn btn-outline-secondary btn-sm">
                @(Model.Pubblicato == false ? "Anteprima" : "Visualizza")
            </a>

            @if (!Model.Pubblicato && currentArea == "Tecnico")
            {
                <a href="@Url.Action(modificaAction, controllerName, new { Area = currentArea, id = Model.Id })" class="btn btn-light btn-sm">Modifica</a>
            }
            else if (Model.Pubblicato)
            {
                <a href="@Url.Action(downloadAction, controllerName, new { Area = currentArea, id = Model.Id })" class="btn btn-light btn-sm">Scarica pdf</a>
            }
        </div>
    </div>
</div>


