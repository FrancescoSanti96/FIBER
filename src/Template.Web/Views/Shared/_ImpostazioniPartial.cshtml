@* Stili personalizzati per Select2 *@
<style>
.select2-container--default .select2-selection--multiple {
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
    min-height: 38px;
}
.select2-container {
    width: 100% !important;
}
.select2-selection__choice {
    background-color: #198754 !important;
    border: 1px solid #198754 !important;
    color: white !important;
}
.select2-selection__choice__remove {
    color: white !important;
}
.select2-selection__choice__remove:hover {
    background-color: rgba(255,255,255,0.2) !important;
}
</style>

<h1 class="text-center mt-3">@ViewData["Title"]</h1>
<p class="text-center text-success" style="margin-bottom: 70px !important;">Modifica le preferenze, per cambiare i bollettini consigliati</p>

@Html.AntiForgeryToken()

<div class="container d-flex justify-content-center mt-4">
    <div class="col-md-4">
        <div class="form-group mb-3" style="margin-bottom: 70px !important;">
            <label for="zona-interesse" class="form-label">Zone di interesse</label>
            <select id="zona-interesse" class="form-control" multiple="multiple"></select>
            <div class="form-text">Puoi selezionare più zone se coltivi in diverse province</div>
        </div>

        <div class="form-group mb-4">
            <label for="cultura-interesse-settings" class="form-label">Coltura di interesse</label>
            <select id="cultura-interesse-settings" class="form-control" multiple="multiple"></select>
            <div class="form-text">Puoi selezionare più colture se coltivi diversi tipi di prodotti</div>
        </div>

        <div class="text-end">
            <button id="btn-salva" class="btn btn-success" disabled>
                <span id="btn-text">Conferma</span>
                <span id="btn-loading" style="display:none;">
                    <i class="fas fa-spinner fa-spin"></i> Salvando...
                </span>
            </button>
        </div>

        <!-- Alert per feedback -->
        <div id="alert-container" class="mt-3"></div>
    </div>
</div>

<script>
$(document).ready(function() {
    const provinceSelect = $('#zona-interesse');
    const coltureSelect = $('#cultura-interesse-settings');
    const btnSalva = $('#btn-salva');
    const alertContainer = $('#alert-container');

    function showAlert(message, type = 'success') {
        alertContainer.html(`
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `);
    }

    function updateButtonState() {
        const hasProvinces = provinceSelect.val()?.length > 0;
        const hasColtures = coltureSelect.val()?.length > 0;
        btnSalva.prop('disabled', !hasProvinces || !hasColtures);
    }

    // Carica province
    $.get('@Url.Action("GetProvinces", "Agricoltore", new { area = "Agricoltore" })')
        .done(response => {
            if (response.success) {
                response.data.forEach(p => provinceSelect.append(`<option value="${p.id}">${p.name}</option>`));
                provinceSelect.select2({ placeholder: 'Seleziona zone', width: '100%' });
            }
        })
        .fail(() => showAlert('Errore nel caricamento delle zone', 'danger'));

    // Carica colture
    $.get('@Url.Action("GetColtures", "Agricoltore", new { area = "Agricoltore" })')
        .done(response => {
            if (response.success) {
                response.data.forEach(c => coltureSelect.append(`<option value="${c.id}">${c.name}</option>`));
                coltureSelect.select2({ placeholder: 'Seleziona colture', width: '100%' });
            }
        })
        .fail(() => showAlert('Errore nel caricamento delle colture', 'danger'));

    // Carica preferenze utente
    $.get('@Url.Action("GetUserPreferences", "Agricoltore", new { area = "Agricoltore" })')
        .done(response => {
            if (response.success && response.data) {
                if (response.data.provinces) provinceSelect.val(response.data.provinces).trigger('change');
                if (response.data.coltures) coltureSelect.val(response.data.coltures).trigger('change');
            }
        });

    // Event listeners
    provinceSelect.add(coltureSelect).on('change', updateButtonState);

    // Salva preferenze
    btnSalva.on('click', function() {
        const provinces = provinceSelect.val()?.map(Number) || [];
        const coltures = coltureSelect.val()?.map(Number) || [];

        if (!provinces.length || !coltures.length) {
            showAlert('Seleziona almeno una zona e una coltura', 'warning');
            return;
        }

        // Mostra loading
        btnSalva.prop('disabled', true);
        $('#btn-text').hide();
        $('#btn-loading').show();

        $.ajax({
            url: '@Url.Action("SaveUserPreferencesAjax", "Agricoltore", new { area = "Agricoltore" })',
            method: 'POST',
            data: JSON.stringify({ provinces, coltures }),
            contentType: 'application/json',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
        })
        .done(response => {
            if (response.success) {
                showAlert(response.message, 'success');
            } else {
                showAlert(response.message, 'danger');
            }
        })
        .fail(() => showAlert('Errore nel salvataggio', 'danger'))
        .always(() => {
            // Ripristina pulsante
            $('#btn-text').show();
            $('#btn-loading').hide();
            updateButtonState();
        });
    });
});
</script> 