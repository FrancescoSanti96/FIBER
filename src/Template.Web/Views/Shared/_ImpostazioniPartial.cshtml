<h1 class="text-center mt-3">@ViewData["Title"]</h1>
<p class="text-center text-success" style="margin-bottom: 70px !important;">Modifica le preferenze, per cambiare i bollettini consigliati</p>

@Html.AntiForgeryToken()

<div class="container d-flex justify-content-center mt-4">
    <div class="col-md-4">
        <div class="form-group mb-3" style="margin-bottom: 70px !important;">
            <sl-select id="zona-interesse" label="Zone di interesse" multiple clearable>
            </sl-select>
            <div class="form-text">Puoi selezionare più zone se coltivi in diverse province</div>
        </div>

        <div class="form-group mb-4">
            <sl-select id="cultura-interesse-settings" label="Coltura di interesse" multiple clearable>
            </sl-select>
            <div class="form-text">Puoi selezionare più colture se coltivi diversi tipi di prodotti</div>
        </div>

        <div class="text-end">
            <button id="btn-salva" class="btn btn-success" disabled>
                <span id="btn-text">Conferma</span>
                <span id="btn-loading" style="display:none;">
                    <i class="fas fa-spinner fa-spin"></i> Salvando...
                </span>
            </button>
        </div>

        <!-- Alert per feedback -->
        <div id="alert-container" class="mt-3"></div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const provinceSelect = document.getElementById('zona-interesse');
    const coltureSelect = document.getElementById('cultura-interesse-settings');
    const btnSalva = document.getElementById('btn-salva');
    const btnText = document.getElementById('btn-text');
    const btnLoading = document.getElementById('btn-loading');
    const alertContainer = document.getElementById('alert-container');

    let userPreferences = null;

    // Carica tutte le province disponibili
    async function loadProvinces() {
        try {
            const response = await fetch('@Url.Action("GetProvinces", "Agricoltore", new { area = "Agricoltore" })');
            const result = await response.json();
            
            if (result.success) {
                // Svuota il select
                provinceSelect.innerHTML = '';
                
                result.data.forEach(p => {
                    const option = document.createElement('sl-option');
                    option.value = p.id.toString();
                    option.textContent = p.name;
                    provinceSelect.appendChild(option);
                });
                
                console.log('Province caricate:', result.data.length);
                
                // Applica le preferenze se disponibili
                if (userPreferences && userPreferences.provinces) {
                    applyProvincePreferences();
                }
            }
        } catch (error) {
            console.error('Errore nel caricamento delle province:', error);
        }
    }

    // Carica tutte le colture disponibili
    async function loadColtures() {
        try {
            const response = await fetch('@Url.Action("GetColtures", "Agricoltore", new { area = "Agricoltore" })');
            const result = await response.json();
            
            if (result.success) {
                // Svuota il select
                coltureSelect.innerHTML = '';
                
                result.data.forEach(c => {
                    const option = document.createElement('sl-option');
                    option.value = c.id.toString();
                    option.textContent = c.name;
                    coltureSelect.appendChild(option);
                });
                
                console.log('Colture caricate:', result.data.length);
                
                // Applica le preferenze se disponibili
                if (userPreferences && userPreferences.coltures) {
                    applyColturePreferences();
                }
            }
        } catch (error) {
            console.error('Errore nel caricamento delle colture:', error);
        }
    }

    // Carica le preferenze salvate dell'utente
    async function loadUserPreferences() {
        try {
            const response = await fetch('@Url.Action("GetUserPreferences", "Agricoltore", new { area = "Agricoltore" })');
            const result = await response.json();
            
            if (result.success && result.data) {
                userPreferences = result.data;
                console.log('Preferenze utente caricate:', userPreferences);
                
                // Applica le preferenze se i select sono già popolati
                applyProvincePreferences();
                applyColturePreferences();
            }
        } catch (error) {
            console.error('Errore nel caricamento delle preferenze:', error);
        }
    }

    // Applica le preferenze alle province
    function applyProvincePreferences() {
        if (userPreferences && userPreferences.provinces && userPreferences.provinces.length > 0) {
            const values = userPreferences.provinces.map(p => p.toString());
            console.log('Applicando preferenze province:', values);
            
            setTimeout(() => {
                provinceSelect.value = values;
                console.log('Province selezionate:', provinceSelect.value);
                updateButtonState();
            }, 100);
        }
    }

    // Applica le preferenze alle colture
    function applyColturePreferences() {
        if (userPreferences && userPreferences.coltures && userPreferences.coltures.length > 0) {
            const values = userPreferences.coltures.map(c => c.toString());
            console.log('Applicando preferenze colture:', values);
            
            setTimeout(() => {
                coltureSelect.value = values;
                console.log('Colture selezionate:', coltureSelect.value);
                updateButtonState();
            }, 100);
        }
    }

    // Inizializza il caricamento dei dati
    async function initializeData() {
        // Prima carica le preferenze
        await loadUserPreferences();
        
        // Poi carica i dati e applica le preferenze
        await Promise.all([loadProvinces(), loadColtures()]);
        
        // Aspetta un po' e riapplica le preferenze per sicurezza
        setTimeout(() => {
            applyProvincePreferences();
            applyColturePreferences();
        }, 300);
    }

    // Funzione per mostrare alert
    function showAlert(message, type = 'success') {
        alertContainer.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
    }

    // Funzione per abilitare/disabilitare il pulsante
    function updateButtonState() {
        const hasProvinces = provinceSelect.value && provinceSelect.value.length > 0;
        const hasColtures = coltureSelect.value && coltureSelect.value.length > 0;
        btnSalva.disabled = !hasProvinces || !hasColtures;
        
        console.log('Stato pulsante - Province:', hasProvinces, 'Colture:', hasColtures);
    }

    // Event listeners per aggiornare lo stato del pulsante
    provinceSelect.addEventListener('sl-change', updateButtonState);
    coltureSelect.addEventListener('sl-change', updateButtonState);

    // Salvataggio delle preferenze
    btnSalva.addEventListener('click', async function() {
        const selectedProvinces = provinceSelect.value || [];
        const selectedColtures = coltureSelect.value || [];

        if (selectedProvinces.length === 0 || selectedColtures.length === 0) {
            showAlert('Seleziona almeno una zona e una coltura di interesse', 'warning');
            return;
        }

        // Mostra loading
        btnText.style.display = 'none';
        btnLoading.style.display = 'inline';
        btnSalva.disabled = true;

        try {
            const response = await fetch('@Url.Action("SaveUserPreferencesAjax", "Agricoltore", new { area = "Agricoltore" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ 
                    Provinces: selectedProvinces.map(Number), 
                    Coltures: selectedColtures.map(Number) 
                })
            });

            const result = await response.json();
            
            if (result.success) {
                showAlert(result.message, 'success');
            } else {
                showAlert(result.message || 'Errore nel salvataggio', 'danger');
            }
        } catch (error) {
            console.error('Errore nel salvataggio:', error);
            showAlert('Errore di connessione', 'danger');
        } finally {
            // Nascondi loading
            btnText.style.display = 'inline';
            btnLoading.style.display = 'none';
            updateButtonState();
        }
    });

    // Inizializza i dati
    initializeData();
});
</script> 