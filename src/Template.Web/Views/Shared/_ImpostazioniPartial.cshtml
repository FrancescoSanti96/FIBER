<h1 class="text-center mt-3">@ViewData["Title"]</h1>
<p class="text-center text-success" style="margin-bottom: 70px !important;">Modifica le preferenze, per cambiare i bollettini consigliati</p>

<div class="container d-flex justify-content-center mt-4">
    <div class="col-md-4">
        <div class="form-group mb-3" style="margin-bottom: 70px !important;">
            <label for="zona-interesse" class="form-label">Zone di interesse</label>
            <select id="zona-interesse" class="form-control text-secondary">
                <option value="">Seleziona almeno una zona di interesse</option>
            </select>
        </div>

        <div class="form-group mb-4">
            <label for="cultura-interesse-settings" class="form-label">Coltura di interesse</label>
            <select id="cultura-interesse-settings" class="form-control text-secondary">
                <option value="" >Seleziona almeno una coltura di interesse</option>
            </select>
        </div>

        <div class="text-end">
            <button class="btn btn-success">Conferma</button>
        </div>
    </div>
</div> 